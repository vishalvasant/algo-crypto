# Delta Exchange API credentials (India)
# Create keys at https://www.delta.exchange → Settings → API
# Whitelist your VPS / machine public IP on the key.
DELTA_API_KEY=
DELTA_API_SECRET=
# india | testnet
DELTA_ENV=india

# Runtime
TRADING_MODE=paper
CONFIG_DIR=./config
LOG_LEVEL=INFO

# Database — independent from algo-flat (different ports/names)
POSTGRES_USER=algocrypto
POSTGRES_PASSWORD=algocrypto
POSTGRES_DB=algocrypto
DATABASE_URL=postgresql://algocrypto:algocrypto@postgres:5432/algocrypto

# Host ports (algo-flat uses 8080/8001/5432/6379)
WEB_PORT=8081
ENGINE_PORT=8002
POSTGRES_PORT=5433
REDIS_PORT=6380

REDIS_URL=redis://redis:6379/0

# Web dashboard login
WEB_USERNAME=admin
WEB_PASSWORD=algocrypto
JWT_SECRET=change-me-use-long-random-string-crypto
